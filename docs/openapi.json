{
 "openapi": "3.1.0",
 "info": {
  "title": "AETHER API",
  "version": "1.0.0",
  "description": "Airport disruption recovery API on a synthetic airport. Mutations need an Idempotency-Key header. Errors are {error:{code,message,traceId}}. Lists are paginated with ?limit and ?cursor (nextCursor). Model calls are simulated (deterministic analyzers charged tokens at a price table); the routing, escalation, gate solver and telemetry are real."
 },
 "components": {
  "securitySchemes": {
   "bearer": {
    "type": "http",
    "scheme": "bearer"
   }
  },
  "schemas": {
   "AgentResult": {
    "type": "object",
    "required": [
     "agent",
     "run_id",
     "status",
     "confidence",
     "findings",
     "evidence_refs",
     "assumptions",
     "warnings",
     "metrics"
    ],
    "additionalProperties": false,
    "properties": {
     "agent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9-]+$"
     },
     "run_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 64
     },
     "status": {
      "type": "string",
      "enum": [
       "success",
       "partial",
       "failed"
      ]
     },
     "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
     },
     "findings": {
      "type": "array",
      "maxItems": 500,
      "items": {
       "type": "object",
       "required": [
        "id",
        "type",
        "summary",
        "confidence",
        "evidence",
        "entities",
        "data"
       ],
       "additionalProperties": false,
       "properties": {
        "id": {
         "type": "string",
         "minLength": 1
        },
        "type": {
         "type": "string",
         "minLength": 1,
         "maxLength": 64
        },
        "summary": {
         "type": "string",
         "maxLength": 1000
        },
        "confidence": {
         "type": "number",
         "minimum": 0,
         "maximum": 1
        },
        "evidence": {
         "type": "array",
         "items": {
          "type": "string"
         },
         "maxItems": 1000
        },
        "entities": {
         "type": "array",
         "items": {
          "type": "string"
         },
         "maxItems": 1000
        },
        "data": {
         "type": "object"
        },
        "technique": {
         "type": "string",
         "maxLength": 32
        }
       }
      }
     },
     "evidence_refs": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "maxItems": 10000
     },
     "assumptions": {
      "type": "array",
      "items": {
       "type": "string",
       "maxLength": 500
      },
      "maxItems": 100
     },
     "warnings": {
      "type": "array",
      "items": {
       "type": "string",
       "maxLength": 500
      },
      "maxItems": 100
     },
     "metrics": {
      "type": "object",
      "required": [
       "latency_ms",
       "input_tokens",
       "output_tokens",
       "estimated_cost_usd"
      ],
      "additionalProperties": false,
      "properties": {
       "latency_ms": {
        "type": "number",
        "minimum": 0
       },
       "input_tokens": {
        "type": "integer",
        "minimum": 0
       },
       "output_tokens": {
        "type": "integer",
        "minimum": 0
       },
       "estimated_cost_usd": {
        "type": "number",
        "minimum": 0
       }
      }
     }
    }
   }
  }
 },
 "paths": {
  "/v1/airport/state": {
   "get": {
    "summary": "The tenant's airport as the web app loads it (bounded: one airport, one three-hour window), plus the latest disruption and the approved option's gate assignments",
    "tags": [
     "airport"
    ],
    "parameters": [
     {
      "schema": {
       "type": "string",
       "enum": [
        "outage"
       ]
      },
