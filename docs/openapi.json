         "triggerType": {
          "type": "string",
          "enum": [
           "thunderstorm",
           "runway_closure",
           "ground_stop"
          ]
         },
         "triggerPayload": {
          "type": "object",
          "required": [
           "start",
           "durationMin"
          ],
          "properties": {
           "start": {
            "type": "string",
            "format": "date-time"
           },
           "durationMin": {
            "type": "integer",
            "minimum": 5,
            "maximum": 240
           },
           "capacityFactor": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
           }
          }
         }
        }
       }
      }
     }
