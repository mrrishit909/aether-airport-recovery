  "/v1/disruptions/{id}/optimize": {
   "post": {
    "summary": "Run the optimization phase: the optimizer agent calls the gate solver for three strategies (plus the wait-for-gates reference), then the recovery synthesizer compares them on compact structured results only",
    "tags": [
     "workflow"
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "faults": {
          "type": "array",
          "maxItems": 8,
          "items": {
           "type": "object",
           "required": [
            "code",
