         "faults": {
          "type": "array",
          "maxItems": 8,
          "items": {
           "type": "object",
           "required": [
            "code",
            "remaining"
           ],
           "properties": {
            "code": {
             "type": "string",
             "enum": [
              "rate_limited",
              "provider_error",
              "timeout"
             ]
            },
            "model": {
             "type": "string",
             "enum": [
              "haiku",
              "sonnet",
              "opus"
             ]
            },
            "agent": {
             "type": "string"
            },
            "remaining": {
             "type": "integer",
             "minimum": 1,
             "maximum": 100
            }
